# ============================================================
#  Copia este archivo como  .env  y rellena tus datos reales.
#  El archivo .env NUNCA se sube a GitHub (esta en .gitignore).
# ============================================================

# Generar una clave nueva con:
#   python manage.py shell -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=cambiar-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos ---
# Opciones: mysql (la que usa el proyecto) | sqlite (para trabajar sin MySQL)
DB_ENGINE=mysql

MYSQL_DATABASE=neuroficha
MYSQL_USER=neuroficha
MYSQL_PASSWORD=tu_password_aqui
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
