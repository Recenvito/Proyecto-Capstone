# ============================================================
#  Copia este archivo como  .env  y rellena tus datos reales.
#  El archivo .env NUNCA se sube a GitHub (esta en .gitignore).
# ============================================================

DJANGO_SECRET_KEY=cambiar-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1

# --- Base de datos ---
# Usa 'sqlite' para desarrollar sin Oracle levantado, u 'oracle' para lo real.
DB_ENGINE=sqlite

# --- Credenciales de Oracle (solo si DB_ENGINE=oracle) ---
# DSN con formato  host:puerto/nombre_del_servicio
ORACLE_DSN=localhost:1521/FREEPDB1
ORACLE_USER=neuroficha
ORACLE_PASSWORD=tu_password_aqui

# Dominios autorizados, separados por coma (sin espacios)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
