# ============================================================
#  Copia este archivo como  .env  y rellena tus datos reales.
#  El archivo .env NUNCA se sube a GitHub (esta en .gitignore).
# ============================================================

# Generar una clave nueva con:
#   python manage.py shell -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=cambiar-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de datos ---
# Opciones: mysql (la que usa el proyecto) | sqlite (para trabajar sin MySQL)
DB_ENGINE=mysql

MYSQL_DATABASE=neuroficha
MYSQL_USER=neuroficha
MYSQL_PASSWORD=tu_password_aqui
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# --- Recuperación de contraseña por correo ---
# En desarrollo se usa la consola por defecto. Para SMTP real, configura:
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.ejemplo.cl
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=1
DJANGO_EMAIL_USE_SSL=0
DJANGO_EMAIL_HOST_USER=usuario-smtp
DJANGO_EMAIL_HOST_PASSWORD=contraseña-smtp
DJANGO_DEFAULT_FROM_EMAIL=NeuroFicha <no-reply@ejemplo.cl>
